# NGO Works Portal - Production Environment Variables
# Copy these key names into your Vercel Project Settings > Environment Variables

# Supabase Project Credentials (from Supabase Dashboard > Project Settings > API)
# REQUIRED. There are no hard-coded fallbacks: if these are missing, private pages return 503.
# Never commit real values. SUPABASE_SERVICE_ROLE_KEY is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL configuration
NEXT_PUBLIC_SITE_URL=https://your-app-name.vercel.app

# Webhook secrets: REQUIRED if Kobo/ODK webhooks are used (unsigned requests are rejected)
KOBO_WEBHOOK_SECRET=your-kobo-webhook-secret
ODK_WEBHOOK_SECRET=your-odk-webhook-secret
GEMINI_API_KEY=your-gemini-api-key
SMS_PROVIDER=mock
